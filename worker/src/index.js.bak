    if (__path === "/app" || __path === "/app/") {
      return new Response('<!DOCTYPE html>\n<html lang="zh-CN">\n<head>\n  <meta charset="UTF-8" />\n  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />\n  <title>GigBounty Studio v1.0.1 — 零工悬赏与双向评价平台</title>\n  <script src="https://telegram.org/js/telegram-web-app.js"></script>\n  <style>\n    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", Roboto, sans-serif;\n      background: linear-gradient(135deg, #121926 0%, #1e3a5f 100%);\n      background-attachment: fixed;\n      color: #f8fafc;\n      margin: 0;\n      padding: 14px;\n      min-height: 100vh;\n    }\n    .container { max-width: 860px; margin: 0 auto; padding-bottom: 48px; }\n    .topbar {\n      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;\n      border-bottom: 1px solid rgba(56, 189, 248, 0.3); padding-bottom: 12px; margin-bottom: 14px;\n    }\n    .brand { font-size: 18px; font-weight: 700; color: #38bdf8; letter-spacing: 0.5px; }\n    .sub { font-size: 11.5px; color: #94a3b8; margin-top: 2px; }\n    .user-pill {\n      display: flex; align-items: center; gap: 8px; background: rgba(15, 23, 42, 0.92);\n      border: 1px solid #38bdf8; border-radius: 999px; padding: 5px 12px; font-size: 12px;\n    }\n    .user-pill select {\n      background: transparent; border: none; color: #f5d076; font-weight: 700; font-size: 12px; padding: 0; margin: 0; width: auto;\n    }\n    .wallet-bar {\n      display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-bottom: 14px;\n    }\n    .stat-card {\n      background: rgba(9, 15, 29, 0.88); border: 1px solid #2a3f5f; border-radius: 10px; padding: 10px 12px;\n    }\n    .stat-label { font-size: 11px; color: #94a3b8; }\n    .stat-val { font-size: 16px; font-weight: 700; color: #f5d076; margin-top: 2px; }\n    .tabs { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }\n    .tab-btn {\n      flex: 1; min-width: 90px; padding: 10px 6px; border-radius: 10px; border: 1px solid #2a3f5f;\n      background: rgba(11, 18, 34, 0.88); color: #94a3b8; font-weight: 600; font-size: 12.5px; cursor: pointer;\n    }\n    .tab-btn.active {\n      border-color: #38bdf8; color: #e0f2fe; background: rgba(30, 58, 95, 0.88);\n      box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);\n    }\n    .card {\n      background: rgba(15, 23, 42, 0.92); border: 1px solid #2a3f5f;\n      border-radius: 12px; padding: 15px; margin-bottom: 14px;\n    }\n    .card h3 { margin: 0 0 10px 0; font-size: 15px; color: #38bdf8; }\n    label { display: block; font-size: 12px; color: #94a3b8; margin-top: 10px; }\n    input, select, textarea {\n      width: 100%; background: #090f1d; border: 1px solid #334155; color: #fff;\n      padding: 10px; border-radius: 8px; margin-top: 4px; font-size: 13.5px; font-family: inherit;\n    }\n    textarea { min-height: 76px; resize: vertical; }\n    .row { display: flex; gap: 8px; flex-wrap: wrap; }\n    .row > * { flex: 1; min-width: 135px; }\n    button {\n      background: #2563eb; color: #fff; border: none; padding: 10px 14px;\n      border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 13px;\n    }\n    .btn-gold { background: linear-gradient(135deg, #b8860b 0%, #d4af37 100%); color: #0f172a; }\n    .btn-green { background: #16a34a; }\n    .btn-red { background: #dc2626; }\n    .btn-slate { background: #334155; }\n    .panel { display: none; }\n    .panel.active { display: block; }\n\n    /* Task Cards */\n    .task-item {\n      background: #090f1d; border: 1px solid #2a3f5f; border-radius: 11px; padding: 13px; margin-bottom: 10px;\n      transition: border-color 0.2s;\n    }\n    .task-item.bounty { border-color: rgba(212, 175, 55, 0.55); background: linear-gradient(160deg, #0b1120 0%, #171f36 100%); }\n    .task-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; flex-wrap: wrap; }\n    .task-title { font-size: 15px; font-weight: 700; color: #f8fafc; }\n    .reward-tag {\n      font-size: 14px; font-weight: 800; color: #f5d076; background: rgba(212, 175, 55, 0.14);\n      border: 1px solid rgba(212, 175, 55, 0.4); padding: 3px 10px; border-radius: 8px; white-space: nowrap;\n    }\n    .meta-row { display: flex; gap: 6px; flex-wrap: wrap; margin: 7px 0; font-size: 11.5px; }\n    .pill {\n      padding: 2px 8px; border-radius: 6px; font-weight: 600;\n      background: rgba(56, 189, 248, 0.14); color: #7dd3fc; border: 1px solid rgba(56, 189, 248, 0.3);\n    }\n    .pill-bounty { background: rgba(245, 158, 11, 0.18); color: #fcd34d; border-color: rgba(245, 158, 11, 0.45); }\n    .pill-status-open { background: rgba(34, 197, 94, 0.15); color: #86efac; border-color: rgba(34, 197, 94, 0.35); }\n    .pill-status-progress { background: rgba(59, 130, 246, 0.18); color: #93c5fd; border-color: rgba(59, 130, 246, 0.4); }\n    .pill-status-submitted { background: rgba(168, 85, 247, 0.18); color: #d8b4fe; border-color: rgba(168, 85, 247, 0.4); }\n    .pill-status-done { background: rgba(148, 163, 184, 0.15); color: #cbd5e1; border-color: rgba(148, 163, 184, 0.35); }\n    .task-desc { font-size: 13px; color: #cbd5e1; line-height: 1.6; margin: 6px 0 10px 0; }\n    .task-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\n\n    /* Review & Modal */\n    .review-box {\n      background: rgba(15, 23, 42, 0.85); border-left: 3px solid #38bdf8;\n      padding: 8px 10px; border-radius: 6px; margin-top: 8px; font-size: 12px; color: #e2e8f0;\n    }\n    .modal-backdrop {\n      position: fixed; inset: 0; background: rgba(2, 6, 23, 0.78); display: none;\n      align-items: center; justify-content: center; padding: 16px; z-index: 999;\n    }\n    .modal-backdrop.show { display: flex; }\n    .modal-card {\n      width: 100%; max-width: 460px; background: #0f172a; border: 1px solid #38bdf8;\n      border-radius: 14px; padding: 16px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);\n    }\n    .ai-box {\n      background: #070c18; border: 1px solid #38bdf8; border-radius: 10px;\n      padding: 12px; margin-top: 10px; font-size: 13px; line-height: 1.65; white-space: pre-wrap;\n    }\n  </style>\n</head>\n<body>\n  <div class="container">\n    <div class="topbar">\n      <div>\n        <div class="brand">⚡ GigBounty Studio · 零工悬赏平台</div>\n        <div class="sub">任务大厅 · 高额悬赏托管 · 交付验收 · 雇主与接单人双向信用评价</div>\n      </div>\n      <div class="user-pill">\n        <span>当前身份：</span>\n        <select id="currentUserSelect" onchange="switchActiveUser()">\n          <option value="u_employer">🏢 雇主 · 星辰科技 (Employer)</option>\n          <option value="u_worker1">🛠️ 接单人 · 阿杰全栈 (Worker A)</option>\n          <option value="u_worker2">🎨 接单人 · 林溪设计 (Worker B)</option>\n        </select>\n      </div>\n    </div>\n\n    <!-- 账户钱包与信用概览 -->\n    <div class="wallet-bar" id="walletBar"></div>\n\n    <div class="tabs">\n      <button class="tab-btn active" onclick="switchTab(\'hall\', this)">🔥 任务大厅</button>\n      <button class="tab-btn" onclick="switchTab(\'publish\', this)">➕ 发布任务/悬赏</button>\n      <button class="tab-btn" onclick="switchTab(\'myorders\', this)">📋 我的订单</button>\n      <button class="tab-btn" onclick="switchTab(\'reputation\', this)">⭐ 双向评价榜</button>\n      <button class="tab-btn" onclick="switchTab(\'settings\', this)">⚙️ 设置/同步</button>\n    </div>\n\n    <!-- TAB 1: 任务大厅 -->\n    <div id="panel-hall" class="panel active">\n      <div class="card">\n        <div class="row" style="align-items:flex-end;">\n          <div>\n            <label style="margin-top:0;">任务类型筛选</label>\n            <select id="filterType" onchange="renderHall()">\n              <option value="ALL">全部任务（普通零工 + 高额悬赏）</option>\n              <option value="BOUNTY">🏆 仅看高额悬赏任务（赏金已托管）</option>\n              <option value="NORMAL">📌 仅看普通零工任务</option>\n            </select>\n          </div>\n          <div>\n            <label style="margin-top:0;">行业分类</label>\n            <select id="filterCategory" onchange="renderHall()">\n              <option value="ALL">全部分类</option>\n              <option value="软件开发">软件开发 / 脚本</option>\n              <option value="设计创意">设计创意 / 视频</option>\n              <option value="跑腿代办", "其他">线下跑腿 / 探店</option>\n              <option value="文案翻译">文案推广 / 翻译</option>\n            </select>\n          </div>\n          <div>\n            <label style="margin-top:0;">排序方式</label>\n            <select id="sortOrder" onchange="renderHall()">\n              <option value="newest">最新发布优先</option>\n              <option value="reward_desc">赏金从高到低</option>\n              <option value="employer_rating">雇主评分最高</option>\n            </select>\n          </div>\n        </div>\n      </div>\n      <div id="hallList"></div>\n    </div>\n\n    <!-- TAB 2: 发布任务 / 悬赏任务 -->\n    <div id="panel-publish" class="panel">\n      <div class="card">\n        <h3>➕ 发布新零工 / 悬赏任务</h3>\n        <div class="row">\n          <div>\n            <label>任务模式</label>\n            <select id="pubMode">\n              <option value="BOUNTY">🏆 悬赏任务（立即从余额预扣托管赏金，曝光置顶）</option>\n              <option value="NORMAL">📌 普通零工任务（验收确认后从余额支付）</option>\n            </select>\n          </div>\n          <div>\n            <label>任务分类</label>\n            <select id="pubCategory">\n              <option value="软件开发">软件开发 / 脚本</option>\n              <option value="设计创意">设计创意 / 视频</option>\n              <option value="跑腿代办", "其他">线下跑腿 / 探店</option>\n              <option value="文案翻译">文案推广 / 翻译</option>\n            </select>\n          </div>\n        </div>\n\n        <label>任务标题</label>\n        <input type="text" id="pubTitle" placeholder="例如：急需制作一款跨境电商商品主图海报（3张）" />\n\n        <div class="row">\n          <div>\n            <label>任务赏金（USDT / CAD）</label>\n            <input type="number" id="pubReward" value="120" min="5" />\n          </div>\n          <div>\n            <label>截止时间 / 交付周期</label>\n            <input type="text" id="pubDeadline" value="48小时内交付" />\n          </div>\n          <div>\n            <label>工作地点</label>\n            <input type="text" id="pubLocation" value="远程线上 / 全球可接" />\n          </div>\n        </div>\n\n        <label>详细需求与验收标准</label>\n        <textarea id="pubDesc" placeholder="写明具体交付物格式、修改次数、验收标准..."></textarea>\n\n        \n        <div style="background:rgba(212,175,55,0.1);border:1px solid rgba(212,175,55,0.45);border-radius:10px;padding:11px;margin-top:10px;font-size:12.5px;line-height:1.6;">\n          <div style="color:#f5d076;font-weight:700;margin-bottom:4px;">💎 TON USDT 悬赏托管收款地址（平台抽佣 10% · 接单人实得 90%）</div>\n          <div style="font-family:monospace;word-break:break-all;color:#e0f2fe;background:#090f1d;padding:7px 9px;border-radius:6px;margin:4px 0;" id="platformTonAddr">UQAi7GWc5DAPgpJxX7eOA_NijNeUHxpiirzAFi1OerKDRt85</div>\n          <div class="row" style="margin-top:6px;">\n            <button type="button" class="btn-slate" style="padding:7px 10px;font-size:12px;" onclick="copyPlatformWallet()">📋 复制收款地址</button>\n            <button type="button" class="btn-gold" style="padding:7px 10px;font-size:12px;" onclick="openTonPayLink()">⚡ 拉起 TON 钱包支付托管</button>\n          </div>\n          <label style="margin-top:8px;">TON 链上转账哈希 / 交易备注（悬赏托管必填，普通任务可留空）</label>\n          <input type="text" id="pubEscrowTx" placeholder="粘贴 TON 支付交易哈希（或本地演示模式直接留空）" />\n        </div>\n\n        <div class="row" style="margin-top:12px;">\n          <button class="btn-slate" onclick="aiPolishTask()">✨ AI 一键润色需求与验收标准</button>\n          <button class="btn-gold" onclick="publishTask()">🚀 立即发布并上架</button>\n        </div>\n        <div id="pubAiBox" class="ai-box" style="display:none;"></div>\n      </div>\n    </div>\n\n    <!-- TAB 3: 我的订单（接单执行 / 交付提交 / 雇主验收打款 / 互评） -->\n    <div id="panel-myorders" class="panel">\n      <div class="card">\n        <h3>📋 我发布的任务 & 我接受的任务</h3>\n        <div style="font-size:12px;color:#94a3b8;margin-bottom:8px;">\n          完整零工闭环：<b>发布托管 → 接单人抢单 → 提交交付成果 → 雇主验收放款 → 双方互评（任务评价 + 雇主评价）</b>\n        </div>\n      </div>\n      \n      <div class="card" style="border-color:rgba(34,197,94,0.45);">\n        <h3>💸 接单人佣金提现（满 10 USDT 起提 · TON 钱包结算）</h3>\n        <div style="font-size:12px;color:#94a3b8;margin-bottom:6px;">\n          验收结算自动扣除 <b>10%</b> 平台服务费，余额满 <b>10 USDT</b> 即可申请提现，通过 <b>@Userstudiobot</b> 审核并打款至您的 TON 钱包。\n        </div>\n        <div class="row">\n          <div>\n            <label style="margin-top:0;">提现金额 (USDT，最低 10)</label>\n            <input type="number" id="wdAmount" value="10" min="10" />\n          </div>\n          <div style="flex:2;">\n            <label style="margin-top:0;">您的 TON 收款钱包地址 (UQ... / EQ...)</label>\n            <input type="text" id="wdWallet" placeholder="粘贴您的 TON 钱包地址..." />\n          </div>\n        </div>\n        <div class="row" style="margin-top:10px;">\n          <button class="btn-green" onclick="requestWithdraw()">💸 提交提现申请</button>\n          <button class="btn-slate" onclick="openSupportBot(\'咨询提现或订单仲裁\')">💬 联系 @Userstudiobot 客服/仲裁</button>\n        </div>\n      </div>\n\n      <div id="myOrdersList"></div>\n    </div>\n\n    <!-- TAB 4: 双向评价榜（任务评价 + 雇主评价） -->\n    <div id="panel-reputation" class="panel">\n      <div class="card">\n        <h3>⭐ 平台双向信用体系（雇主口碑 & 接单人任务评价）</h3>\n        <div id="userStatsGrid" class="wallet-bar"></div>\n      </div>\n      <div class="card">\n        <h3>💬 最新双向评价记录</h3>\n        <div id="reviewsFeed"></div>\n      </div>\n    </div>\n\n    <!-- TAB 5: 设置 / 云端同步配置 -->\n    <div id="panel-settings" class="panel">\n      <div class="card">\n        <h3>☁️ 云端数据存储与多端同步（可选配置）</h3>\n        <div style="font-size:12.5px;color:#cbd5e1;line-height:1.65;">\n          当前默认使用本机 <code>localStorage</code> 离线持久化存储（随时可切换上方 3 个测试账号体验完整发布、抢单、托管放款与双向评价闭环）。<br/>\n          如需多人联机，可填入你自己的 Cloudflare Workers / Supabase REST 接口地址实现全网实时同步。\n        </div>\n        <label>（可选）自定义云端同步 API URL</label>\n        <input type="text" id="syncEndpoint" placeholder="https://your-worker.workers.dev/api/tasks" />\n        <label>（可选）Gemini API Key（用于 AI 需求润色与智能估价，支持 AQ. / AIza）</label>\n        <input type="password" id="geminiKeyInput" placeholder="粘贴 AQ.Ab... 或 AIza..." />\n        <div class="row" style="margin-top:10px;">\n          <button class="btn-green" onclick="saveSettings()">💾 保存配置</button>\n          <button class="btn-red" onclick="resetDemoData()">↺ 重置演示数据</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 双向评价弹窗（任务评价 / 雇主评价） -->\n  <div id="reviewModal" class="modal-backdrop">\n    <div class="modal-card">\n      <h3 id="modalTitle" style="margin-top:0;color:#f5d076;">⭐ 提交评价</h3>\n      <div id="modalSub" style="font-size:12px;color:#94a3b8;margin-bottom:8px;"></div>\n      <label>综合星级评分</label>\n      <select id="revStars">\n        <option value="5">⭐⭐⭐⭐⭐ 5.0 分（非常满意 / 强烈推荐）</option>\n        <option value="4">⭐⭐⭐⭐ 4.0 分（良好 / 顺利完成）</option>\n        <option value="3">⭐⭐⭐ 3.0 分（一般 / 基本达标）</option>\n        <option value="2">⭐⭐ 2.0 分（体验欠佳）</option>\n        <option value="1">⭐ 1.0 分（严重不符）</option>\n      </select>\n      <label>快捷印象标签</label>\n      <input type="text" id="revTags" value="沟通顺畅, 结算爽快, 专业靠谱" />\n      <label>详细评价内容</label>\n      <textarea id="revComment" placeholder="写下对本次任务交付质量或雇主结款速度的真实评价..."></textarea>\n      <div class="row" style="margin-top:12px;">\n        <button class="btn-slate" onclick="closeReviewModal()">取消</button>\n        <button class="btn-gold" onclick="submitReview()">确认提交评价</button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const DB_KEY = "gigbounty_studio_db_v1";\n    const KEY_GEMINI = "gigbounty_gemini_key";\n    const KEY_SYNC = "gigbounty_sync_url";\n\n    const DEFAULT_DB = {\n      users: {\n        u_employer: { id: "u_employer", name: "星辰科技", role: "雇主", balance: 2500, frozen: 300, employerScore: 4.9, employerCount: 18, workerScore: 5.0, workerCount: 2 },\n        u_worker1:  { id: "u_worker1",  name: "阿杰全栈", role: "接单人", balance: 480, frozen: 0, employerScore: 5.0, employerCount: 1, workerScore: 4.95, workerCount: 34 },\n        u_worker2:  { id: "u_worker2",  name: "林溪设计", role: "接单人", balance: 620, frozen: 0, employerScore: 4.8, employerCount: 3, workerScore: 4.9, workerCount: 27 }\n      },\n      tasks: [\n        {\n          id: "T-1001",\n          mode: "BOUNTY",\n          category: "软件开发",\n          title: "🏆【高额悬赏】开发一款 Telegram Mini App 积分签到页面",\n          reward: 300,\n          escrowed: true,\n          deadline: "72小时内",\n          location: "远程线上",\n          desc: "需适配深色科技风 UI，支持每日签到领积分、邀请好友裂变统计，提供完整 HTML/JS 源码。",\n          status: "OPEN",\n          employerId: "u_employer",\n          workerId: null,\n          deliveryNote: "",\n          createdAt: "2026-11-22 20:15",\n          taskReview: null,\n          employerReview: null\n        },\n        {\n          id: "T-1002",\n          mode: "NORMAL",\n          category: "设计创意",\n          title: "独立站暗黑科技风 640x360 封面图设计（共 3 张）",\n          reward: 85,\n          escrowed: false,\n          deadline: "24小时内",\n          location: "远程线上",\n          desc: "主色调采用深蓝渐变配金色高光，突出零库存自动发货卖点，交付 PNG + PSD 源文件。",\n          status: "COMPLETED",\n          employerId: "u_employer",\n          workerId: "u_worker2",\n          deliveryNote: "已完成 3 套暗黑科技风封面图并上传网盘源文件，请查收。",\n          createdAt: "2026-11-21 14:30",\n          taskReview: { stars: 5, tags: "交付极快, 审美在线", comment: "林溪设计非常懂暗黑科技质感，一次过稿！", by: "星辰科技", at: "2026-11-22 10:05" },\n          employerReview: { stars: 5, tags: "需求明确, 秒放款", comment: "星辰科技需求清晰不折腾，验收完立刻放款，合作愉快！", by: "林溪设计", at: "2026-11-22 10:12" }\n        },\n        {\n          id: "T-1003",\n          mode: "BOUNTY",\n          category: "跑腿代办", "其他",\n          title: "🏆【悬赏】多伦多/萨德伯里本地商超生鲜价格实地拍摄调研",\n          reward: 95,\n          escrowed: true,\n          deadline: "本周五前",\n          location: "Ontario, Canada",\n          desc: "前往指定 2 家本地超市拍摄牛腩、五花肉及日用品价签照片（不少于 20 张清晰图）并整理表格。",\n          status: "IN_PROGRESS",\n          employerId: "u_employer",\n          workerId: "u_worker1",\n          deliveryNote: "",\n          createdAt: "2026-11-22 18:00",\n          taskReview: null,\n          employerReview: null\n        }\n      ]\n    };\n\n    \n    const PLATFORM_FEE_RATE = 0.10;\n    const MIN_WITHDRAW_USDT = 10;\n    const PLATFORM_TON_WALLET = "UQAi7GWc5DAPgpJxX7eOA_NijNeUHxpiirzAFi1OerKDRt85";\n    const SUPPORT_BOT = "Userstudiobot";\n\n    function copyPlatformWallet() {\n      navigator.clipboard?.writeText(PLATFORM_TON_WALLET).then(() => {\n        alert("✅ 已复制平台 TON 收款地址：\\n" + PLATFORM_TON_WALLET);\n      }).catch(() => {\n        prompt("请手动复制平台 TON 收款地址：", PLATFORM_TON_WALLET);\n      });\n    }\n\n    function openTonPayLink() {\n      const amt = parseFloat(document.getElementById("pubReward").value || "10");\n      const title = encodeURIComponent("GigBounty_" + (document.getElementById("pubTitle").value.trim().slice(0, 18) || "Task"));\n      const tonUrl = "ton://transfer/" + PLATFORM_TON_WALLET + "?text=" + title + "_USDT_" + amt;\n      window.open(tonUrl, "_blank");\n    }\n\n    function openSupportBot(topic) {\n      const url = "https://t.me/" + SUPPORT_BOT + "?start=" + encodeURIComponent(topic || "gig_support");\n      if (window.Telegram?.WebApp?.openTelegramLink) {\n        window.Telegram.WebApp.openTelegramLink(url);\n      } else {\n        window.open(url, "_blank");\n      }\n    }\n\n    function requestWithdraw() {\n      const amt = parseFloat(document.getElementById("wdAmount").value || "0");\n      const wallet = (document.getElementById("wdWallet").value || "").trim();\n      if (amt < MIN_WITHDRAW_USDT) return alert("最低提现门槛为 " + MIN_WITHDRAW_USDT + " USDT！");\n      if (!wallet || wallet.length < 20) return alert("请填写有效的 TON 收款钱包地址！");\n      const u = state.users[activeUserId];\n      if (u.balance < amt) return alert("可用余额不足（当前可用：$" + u.balance.toFixed(2) + "）！");\n\n      const syncUrl = (localStorage.getItem(KEY_SYNC) || "").trim().replace(/\\/+$/, "");\n      if (syncUrl) {\n        fetch(syncUrl + "/api/gig/withdraw", {\n          method: "POST",\n          headers: { "Content-Type": "application/json" },\n          body: JSON.stringify({ tg_id: u.id, username: u.name, amount_usdt: amt, ton_wallet: wallet })\n        }).then(r => r.json()).then(d => {\n          if (!d.ok) return alert("提现失败：" + (d.error || "未知错误"));\n          u.balance -= amt;\n          saveDB();\n          alert("✅ 提现申请已推送至云端后台，将通过 @" + SUPPORT_BOT + " 审核打款！");\n        }).catch(e => alert("云端请求失败：" + e.message));\n        return;\n      }\n\n      u.balance -= amt;\n      saveDB();\n      if (confirm("✅ 已扣减余额 $" + amt + " 并生成提现工单！\\n是否立即跳转 @" + SUPPORT_BOT + " 发送提现收款地址加速审核？")) {\n        openSupportBot("withdraw_" + amt + "USDT_" + wallet.slice(0, 12));\n      }\n    }\n\n    function initTelegramMiniApp() {\n      const tg = window.Telegram?.WebApp;\n      if (!tg) return;\n      tg.ready();\n      tg.expand();\n      const tgUser = tg.initDataUnsafe?.user;\n      if (tgUser && tgUser.id) {\n        const uid = "tg_" + tgUser.id;\n        const uname = tgUser.username ? "@" + tgUser.username : (tgUser.first_name || "TG用户");\n        if (!state.users[uid]) {\n          state.users[uid] = {\n            id: uid, name: uname, role: "Telegram用户",\n            balance: 0, frozen: 0, employerScore: 5.0, employerCount: 0, workerScore: 5.0, workerCount: 0\n          };\n          saveDB();\n        }\n        const sel = document.getElementById("currentUserSelect");\n        if (!Array.from(sel.options).some(o => o.value === uid)) {\n          const opt = document.createElement("option");\n          opt.value = uid;\n          opt.textContent = "✈️ TG本人 · " + uname;\n          sel.prepend(opt);\n        }\n        sel.value = uid;\n        activeUserId = uid;\n        initQueryBridge();\n      initTelegramMiniApp();\n      renderAll();\n      }\n    }\n\n    \n    function initQueryBridge() {\n      const q = new URLSearchParams(window.location.search);\n      const apiParam = (q.get("api") || "").trim();\n      if (apiParam && !localStorage.getItem(KEY_SYNC)) {\n        localStorage.setItem(KEY_SYNC, apiParam);\n        const inp = document.getElementById("syncEndpoint");\n        if (inp) inp.value = apiParam;\n      }\n      const tgId = (q.get("tg_id") || "").trim();\n      if (tgId && !window.Telegram?.WebApp?.initDataUnsafe?.user?.id) {\n        const uid = "tg_" + tgId;\n        const uname = q.get("tg_username") ? "@" + q.get("tg_username") : (q.get("tg_name") || "TG用户");\n        if (!state.users[uid]) {\n          state.users[uid] = {\n            id: uid, name: uname, role: "Telegram用户",\n            balance: 0, frozen: 0, employerScore: 5.0, employerCount: 0, workerScore: 5.0, workerCount: 0\n          };\n          saveDB();\n        }\n        const sel = document.getElementById("currentUserSelect");\n        if (sel) {\n          if (!Array.from(sel.options).some(o => o.value === uid)) {\n            const opt = document.createElement("option");\n            opt.value = uid;\n            opt.textContent = "✈️ TG本人 · " + uname;\n            sel.prepend(opt);\n          }\n          sel.value = uid;\n          activeUserId = uid;\n        }\n      }\n    }\n\n    let state = loadDB();\n    let activeUserId = "u_employer";\n    let reviewTarget = null; // { taskId, kind: \'task\' | \'employer\' }\n\n    function loadDB() {\n      try {\n        const raw = localStorage.getItem(DB_KEY);\n        if (raw) return JSON.parse(raw);\n      } catch (e) {}\n      return JSON.parse(JSON.stringify(DEFAULT_DB));\n    }\n\n    function saveDB() {\n      localStorage.setItem(DB_KEY, JSON.stringify(state));\n      renderAll();\n    }\n\n    function resetDemoData() {\n      state = JSON.parse(JSON.stringify(DEFAULT_DB));\n      saveDB();\n      alert("✅ 已恢复初始演示数据！");\n    }\n\n    function switchActiveUser() {\n      activeUserId = document.getElementById("currentUserSelect").value;\n      renderAll();\n    }\n\n    function switchTab(id, btn) {\n      document.querySelectorAll(".panel").forEach(p => p.classList.remove("active"));\n      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));\n      document.getElementById("panel-" + id).classList.add("active");\n      btn.classList.add("active");\n      renderAll();\n    }\n\n    function renderWallet() {\n      const u = state.users[activeUserId];\n      document.getElementById("walletBar").innerHTML =\n        \'<div class="stat-card"><div class="stat-label">可用余额</div><div class="stat-val">$\' + u.balance.toFixed(2) + \'</div></div>\' +\n        \'<div class="stat-card"><div class="stat-label">悬赏托管冻结中</div><div class="stat-val" style="color:#38bdf8;">$\' + u.frozen.toFixed(2) + \'</div></div>\' +\n        \'<div class="stat-card"><div class="stat-label">雇主信用评分</div><div class="stat-val" style="color:#86efac;">⭐ \' + u.employerScore.toFixed(2) + \' (\' + u.employerCount + \'单)</div></div>\' +\n        \'<div class="stat-card"><div class="stat-label">接单人任务评分</div><div class="stat-val" style="color:#c4b5fd;">⭐ \' + u.workerScore.toFixed(2) + \' (\' + u.workerCount + \'单)</div></div>\';\n    }\n\n    function statusBadge(st) {\n      const map = {\n        OPEN: [\'pill-status-open\', \'🟢 招募中（可接单）\'],\n        IN_PROGRESS: [\'pill-status-progress\', \'🔵 进行中\'],\n        SUBMITTED: [\'pill-status-submitted\', \'🟣 已交付待验收\'],\n        COMPLETED: [\'pill-status-done\', \'✅ 已完成结算\']\n      };\n      const [cls, txt] = map[st] || [\'pill-status-open\', st];\n      return \'<span class="pill \' + cls + \'">\' + txt + \'</span>\';\n    }\n\n    function renderTaskCard(t, contextMode) {\n      const emp = state.users[t.employerId];\n      const wrk = t.workerId ? state.users[t.workerId] : null;\n      const isBounty = t.mode === "BOUNTY";\n\n      let actions = "";\n      if (t.status === "OPEN") {\n        if (t.employerId === activeUserId) {\n          actions += \'<button class="btn-slate" disabled>等待接单人抢单...</button>\';\n          actions += \'<button class="btn-red" onclick="cancelTask(\\\'\' + t.id + \'\\\')">撤回任务</button>\';\n        } else {\n          actions += \'<button class="btn-green" onclick="acceptTask(\\\'\' + t.id + \'\\\')">⚡ 立即接受任务</button>\';\n        }\n      } else if (t.status === "IN_PROGRESS") {\n        if (t.workerId === activeUserId) {\n          actions += \'<button class="btn-gold" onclick="submitWork(\\\'\' + t.id + \'\\\')">📤 提交交付成果</button>\';\n        } else {\n          actions += \'<span style="font-size:12px;color:#93c5fd;">承接人：\' + wrk.name + \'（⭐\' + wrk.workerScore.toFixed(1) + \'）正在执行中</span>\';\n        }\n      } else if (t.status === "SUBMITTED") {\n        if (t.employerId === activeUserId) {\n          actions += \'<button class="btn-green" onclick="approveAndPay(\\\'\' + t.id + \'\\\')">✅ 确认验收并放款 $\' + t.reward + \'</button>\';\n        } else {\n          actions += \'<span style="font-size:12px;color:#d8b4fe;">已提交交付，等待雇主验收打款...</span>\';\n        }\n      } else if (t.status === "COMPLETED") {\n        if (t.employerId === activeUserId && !t.taskReview) {\n          actions += \'<button class="btn-gold" onclick="openReviewModal(\\\'\' + t.id + \'\\\', \\\'task\\\')">⭐ 评价任务交付</button>\';\n        }\n        if (t.workerId === activeUserId && !t.employerReview) {\n          actions += \'<button class="btn-gold" onclick="openReviewModal(\\\'\' + t.id + \'\\\', \\\'employer\\\')">⭐ 评价雇主信用</button>\';\n        }\n      }\n\n      let extraHtml = "";\n      if (t.deliveryNote) {\n        extraHtml += \'<div class="review-box" style="border-color:#a855f7;"><b>📦 交付说明：</b>\' + t.deliveryNote + \'</div>\';\n      }\n      if (t.taskReview) {\n        extraHtml += \'<div class="review-box"><b>🛠️ 雇主对任务评价（⭐\' + t.taskReview.stars + \'.0 · \' + t.taskReview.tags + \'）：</b>\' + t.taskReview.comment + \'</div>\';\n      }\n      if (t.employerReview) {\n        extraHtml += \'<div class="review-box" style="border-color:#f5d076;"><b>🏢 接单人对雇主评价（⭐\' + t.employerReview.stars + \'.0 · \' + t.employerReview.tags + \'）：</b>\' + t.employerReview.comment + \'</div>\';\n      }\n\n      return \'<div class="task-item \' + (isBounty ? \'bounty\' : \'\') + \'">\' +\n        \'<div class="task-head">\' +\n          \'<div class="task-title">\' + t.title + \'</div>\' +\n          \'<div class="reward-tag">$\' + t.reward + (t.escrowed ? \' · 已托管\' : \'\') + \'</div>\' +\n        \'</div>\' +\n        \'<div class="meta-row">\' +\n          (isBounty ? \'<span class="pill pill-bounty">🏆 高额悬赏</span>\' : \'<span class="pill">📌 普通零工</span>\') +\n          \'<span class="pill">\' + t.category + \'</span>\' +\n          statusBadge(t.status) +\n          \'<span class="pill">🏢 雇主：\' + emp.name + \' (⭐\' + emp.employerScore.toFixed(1) + \')</span>\' +\n          \'<span class="pill">⏱ \' + t.deadline + \' · 📍 \' + t.location + \'</span>\' +\n        \'</div>\' +\n        \'<div class="task-desc">\' + t.desc + \'</div>\' +\n        \'<div class="task-actions">\' + actions + \'</div>\' +\n        extraHtml +\n      \'</div>\';\n    }\n\n    function renderHall() {\n      const fType = document.getElementById("filterType").value;\n      const fCat = document.getElementById("filterCategory").value;\n      const sort = document.getElementById("sortOrder").value;\n\n      let list = [...state.tasks];\n      if (fType !== "ALL") list = list.filter(t => t.mode === fType);\n      if (fCat !== "ALL") list = list.filter(t => t.category === fCat);\n\n      if (sort === "reward_desc") list.sort((a, b) => b.reward - a.reward);\n      else if (sort === "employer_rating") list.sort((a, b) => state.users[b.employerId].employerScore - state.users[a.employerId].employerScore);\n\n      document.getElementById("hallList").innerHTML = list.length\n        ? list.map(t => renderTaskCard(t, "hall")).join("")\n        : \'<div class="card" style="text-align:center;color:#94a3b8;">暂无符合筛选条件的任务</div>\';\n    }\n\n    function renderMyOrders() {\n      const mine = state.tasks.filter(t => t.employerId === activeUserId || t.workerId === activeUserId);\n      document.getElementById("myOrdersList").innerHTML = mine.length\n        ? mine.map(t => renderTaskCard(t, "mine")).join("")\n        : \'<div class="card" style="text-align:center;color:#94a3b8;">当前身份暂无发布或承接的任务，去「🔥 任务大厅」看看吧！</div>\';\n    }\n\n    function renderReputation() {\n      const users = Object.values(state.users);\n      document.getElementById("userStatsGrid").innerHTML = users.map(u =>\n        \'<div class="stat-card">\' +\n          \'<div class="stat-label">\' + u.name + \'（\' + u.role + \'）</div>\' +\n          \'<div style="font-size:12.5px;margin-top:4px;color:#86efac;">🏢 雇主评分：⭐ \' + u.employerScore.toFixed(2) + \'（\' + u.employerCount + \'条）</div>\' +\n          \'<div style="font-size:12.5px;margin-top:2px;color:#c4b5fd;">🛠️ 接单评分：⭐ \' + u.workerScore.toFixed(2) + \'（\' + u.workerCount + \'条）</div>\' +\n        \'</div>\'\n      ).join("");\n\n      const feeds = [];\n      state.tasks.forEach(t => {\n        if (t.taskReview) feeds.push({ title: t.title, type: "🛠️ 任务评价", ...t.taskReview });\n        if (t.employerReview) feeds.push({ title: t.title, type: "🏢 雇主评价", ...t.employerReview });\n      });\n      document.getElementById("reviewsFeed").innerHTML = feeds.length\n        ? feeds.map(r =>\n            \'<div class="review-box" style="margin-bottom:8px;">\' +\n              \'<b>\' + r.type + \' · ⭐ \' + r.stars + \'.0</b> — 评价人：\' + r.by + \' <span style="color:#94a3b8;">(\' + r.at + \')</span><br/>\' +\n              \'<span style="color:#f5d076;">标签：\' + r.tags + \'</span><br/>\' +\n              \'内容：\' + r.comment + \'<br/>\' +\n              \'<span style="font-size:11px;color:#94a3b8;">关联任务：\' + r.title + \'</span>\' +\n            \'</div>\'\n          ).join("")\n        : \'<div style="color:#94a3b8;font-size:13px;">暂无评价记录</div>\';\n    }\n\n    // ========== 核心业务动作：发布 / 悬赏托管 / 接单 / 交付 / 验收放款 / 双向评价 ==========\n    function publishTask() {\n      const mode = document.getElementById("pubMode").value;\n      const category = document.getElementById("pubCategory").value;\n      const title = document.getElementById("pubTitle").value.trim();\n      const reward = parseFloat(document.getElementById("pubReward").value || "0");\n      const deadline = document.getElementById("pubDeadline").value.trim() || "72小时内";\n      const location = document.getElementById("pubLocation").value.trim() || "远程线上";\n      const desc = document.getElementById("pubDesc").value.trim();\n\n      if (!title || !desc || reward <= 0) return alert("请填写完整的任务标题、描述和有效赏金！");\n      const emp = state.users[activeUserId];\n      const isBounty = mode === "BOUNTY";\n\n      if (isBounty) {\n        if (emp.balance < reward) return alert("可用余额不足以托管该悬赏金额（当前可用：$" + emp.balance + "）！");\n        emp.balance -= reward;\n        emp.frozen += reward;\n      }\n\n      const newTask = {\n        id: "T-" + Math.floor(1000 + Math.random() * 9000),\n        mode,\n        category,\n        title: isBounty && !title.includes("悬赏") ? "🏆【悬赏】" + title : title,\n        reward,\n        escrowed: isBounty,\n        deadline,\n        location,\n        desc,\n        status: "OPEN",\n        employerId: activeUserId,\n        workerId: null,\n        deliveryNote: "",\n        createdAt: new Date().toISOString().slice(0, 16).replace("T", " "),\n        taskReview: null,\n        employerReview: null\n      };\n\n      state.tasks.unshift(newTask);\n      document.getElementById("pubTitle").value = "";\n      document.getElementById("pubDesc").value = "";\n      saveDB();\n      alert(isBounty ? "✅ 悬赏任务已发布，赏金 $" + reward + " 已托管锁定！" : "✅ 普通零工任务已发布上架！");\n      document.querySelectorAll(".tab-btn")[0].click();\n    }\n\n    function cancelTask(taskId) {\n      const idx = state.tasks.findIndex(t => t.id === taskId);\n      if (idx === -1) return;\n      const t = state.tasks[idx];\n      if (t.escrowed) {\n        const emp = state.users[t.employerId];\n        emp.frozen -= t.reward;\n        emp.balance += t.reward;\n      }\n      state.tasks.splice(idx, 1);\n      saveDB();\n      alert("已撤回任务，若有托管赏金已原路退回可用余额。");\n    }\n\n    function acceptTask(taskId) {\n      const t = state.tasks.find(x => x.id === taskId);\n      if (!t || t.status !== "OPEN") return;\n      if (t.employerId === activeUserId) return alert("不能接自己发布的任务！");\n      t.workerId = activeUserId;\n      t.status = "IN_PROGRESS";\n      saveDB();\n      alert("🎉 抢单成功！请前往「📋 我的订单」按期完成并提交交付成果。");\n    }\n\n    function submitWork(taskId) {\n      const t = state.tasks.find(x => x.id === taskId);\n      if (!t || t.workerId !== activeUserId) return;\n      const note = prompt("请输入交付物链接或完成说明（例如：源码已推送到 GitHub / 设计稿网盘链接）：", "已完成全部需求开发与自测，交付文件已上传，请雇主验收。");\n      if (!note) return;\n      t.deliveryNote = note.trim();\n      t.status = "SUBMITTED";\n      saveDB();\n      alert("📤 已提交交付，等待雇主验收放款！");\n    }\n\n    function approveAndPay(taskId) {\n      const t = state.tasks.find(x => x.id === taskId);\n      if (!t || t.employerId !== activeUserId) return;\n      const emp = state.users[t.employerId];\n      const wrk = state.users[t.workerId];\n\n      if (t.escrowed) {\n        emp.frozen -= t.reward;\n      } else {\n        if (emp.balance < t.reward) return alert("可用余额不足，无法支付赏金！");\n        emp.balance -= t.reward;\n      }\n      const platformFee = Number((t.reward * PLATFORM_FEE_RATE).toFixed(2));\n      const workerNet = Number((t.reward - platformFee).toFixed(2));\n      wrk.balance += workerNet;\n      t.status = "COMPLETED";\n      saveDB();\n      alert("✅ 验收通过！总赏金 $" + t.reward + "，扣除平台 10% 抽佣 ($" + platformFee + ") 后，实得 $" + workerNet + " 已结算至「" + wrk.name + "」账户！");\n    }\n\n    function openReviewModal(taskId, kind) {\n      reviewTarget = { taskId, kind };\n      document.getElementById("modalTitle").innerText = kind === "task" ? "⭐ 提交任务交付评价" : "⭐ 提交雇主信用评价";\n      document.getElementById("modalSub").innerText = kind === "task"\n        ? "评价接单人的交付质量、响应速度与专业度"\n        : "评价雇主的需求清晰度、沟通态度与结款爽快度";\n      document.getElementById("revTags").value = kind === "task" ? "交付准时, 质量过硬, 沟通顺畅" : "需求清晰, 验收爽快, 值得信赖";\n      document.getElementById("revComment").value = "";\n      document.getElementById("reviewModal").classList.add("show");\n    }\n\n    function closeReviewModal() {\n      document.getElementById("reviewModal").classList.remove("show");\n      reviewTarget = null;\n    }\n\n    function submitReview() {\n      if (!reviewTarget) return;\n      const t = state.tasks.find(x => x.id === reviewTarget.taskId);\n      const stars = parseInt(document.getElementById("revStars").value, 10);\n      const tags = document.getElementById("revTags").value.trim() || "好评";\n      const comment = document.getElementById("revComment").value.trim() || "合作非常顺利，五星好评！";\n      const reviewer = state.users[activeUserId];\n\n      const rec = {\n        stars,\n        tags,\n        comment,\n        by: reviewer.name,\n        at: new Date().toISOString().slice(0, 16).replace("T", " ")\n      };\n\n      if (reviewTarget.kind === "task") {\n        t.taskReview = rec;\n        const wrk = state.users[t.workerId];\n        wrk.workerScore = (wrk.workerScore * wrk.workerCount + stars) / (wrk.workerCount + 1);\n        wrk.workerCount += 1;\n      } else {\n        t.employerReview = rec;\n        const emp = state.users[t.employerId];\n        emp.employerScore = (emp.employerScore * emp.employerCount + stars) / (emp.employerCount + 1);\n        emp.employerCount += 1;\n      }\n\n      closeReviewModal();\n      saveDB();\n      alert("🎉 评价已发布并计入对方信用档案！");\n    }\n\n    // ========== 可选 Gemini AI 需求润色与估价 ==========\n    const GEMINI_MODELS = ["gemini-3.5-flash-lite", "gemini-3.5-flash", "gemini-3.6-flash"];\n\n    async function aiPolishTask() {\n      const apiKey = (localStorage.getItem(KEY_GEMINI) || "").trim();\n      const title = document.getElementById("pubTitle").value.trim();\n      const desc = document.getElementById("pubDesc").value.trim();\n      if (!title && !desc) return alert("请先输入初步的任务标题或简单想法！");\n      if (!(apiKey.startsWith("AIza") || apiKey.startsWith("AQ."))) {\n        return alert("请先在「⚙️ 设置/同步」中填入 Gemini API Key，即可自动润色任务书与建议悬赏报价。");\n      }\n      const box = document.getElementById("pubAiBox");\n      box.style.display = "block";\n      box.textContent = "⏳ AI 正在为您生成标准零工需求说明书与合理赏金区间...";\n      const prompt = "你是一位资深的零工平台项目经理。请将以下简略需求润色为清晰、防纠纷的【任务交付清单 + 验收标准 + 建议悬赏报价(USD)】：\\n标题：" + title + "\\n补充：" + desc;\n\n      for (const m of GEMINI_MODELS) {\n        try {\n          const res = await fetch("https://generativelanguage.googleapis.com/v1beta/models/" + m + ":generateContent?key=" + encodeURIComponent(apiKey), {\n            method: "POST",\n            headers: { "Content-Type": "application/json" },\n            body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })\n          });\n          if (res.ok) {\n            const data = await res.json();\n            box.textContent = data.candidates?.[0]?.content?.parts?.[0]?.text || "";\n            return;\n          }\n        } catch (e) {}\n      }\n      box.textContent = "❌ 请求失败，请检查网络或 API Key 配额。";\n    }\n\n    function saveSettings() {\n      localStorage.setItem(KEY_SYNC, document.getElementById("syncEndpoint").value.trim());\n      localStorage.setItem(KEY_GEMINI, document.getElementById("geminiKeyInput").value.trim());\n      alert("✅ 配置已保存！");\n    }\n\n    function renderAll() {\n      renderWallet();\n      renderHall();\n      renderMyOrders();\n      renderReputation();\n    }\n\n    (function boot() {\n      document.getElementById("syncEndpoint").value = localStorage.getItem(KEY_SYNC) || "";\n      document.getElementById("geminiKeyInput").value = localStorage.getItem(KEY_GEMINI) || "";\n      renderAll();\n    })();\n  </script>\n</body>\n</html>\n\n', {
        status: 200,
        headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-cache" }
      });
    }

    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type, X-TG-User-Id, X-TG-Username, X-TG-Name"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const url = new URL(request.url);
    const path = url.pathname;
    const feeRate = parseFloat(env.PLATFORM_FEE_RATE || "0.10");
    const minWithdraw = parseFloat(env.MIN_WITHDRAW_USDT || "10");
    const platformWallet = env.PLATFORM_TON_WALLET || "UQAi7GWc5DAPgpJxX7eOA_NijNeUHxpiirzAFi1OerKDRt85";

    const json = (data, status = 200) =>
      new Response(JSON.stringify(data), {
        status,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });

    async function notifyAdmin(text) {
      if (!env.TELEGRAM_BOT_TOKEN || !env.ADMIN_CHAT_ID) return;
      try {
        await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            chat_id: env.ADMIN_CHAT_ID,
            text,
            parse_mode: "HTML"
          })
        });
      } catch (e) {}
    }

    async function ensureUser(tgId, username, displayName) {
      if (!tgId) return null;
      await env.DB.prepare(
        `INSERT OR IGNORE INTO gig_users (tg_id, username, display_name) VALUES (?, ?, ?)`
      ).bind(tgId, username || "", displayName || username || tgId).run();
      return await env.DB.prepare(`SELECT * FROM gig_users WHERE tg_id = ?`).bind(tgId).first();
    }

    try {
      // 1. Health & Config
      if (path === "/api/gig/config" && request.method === "GET") {
        return json({
          ok: true,
          feeRate,
          minWithdraw,
          platformWallet,
          supportBot: env.SUPPORT_BOT_USERNAME || "Userstudiobot"
        });
      }

      // 2. Bootstrap (Users, Tasks, Reviews)
      if (path === "/api/gig/bootstrap" && request.method === "GET") {
        const tgId = request.headers.get("X-TG-User-Id") || url.searchParams.get("tg_id");
        const username = request.headers.get("X-TG-Username") || "";
        const displayName = decodeURIComponent(request.headers.get("X-TG-Name") || username || "TG User");
        if (tgId) await ensureUser(tgId, username, displayName);

        const users = (await env.DB.prepare(`SELECT * FROM gig_users`).all()).results || [];
        const tasks = (await env.DB.prepare(`SELECT * FROM gig_tasks ORDER BY created_at DESC LIMIT 100`).all()).results || [];
        const reviews = (await env.DB.prepare(`SELECT * FROM gig_reviews ORDER BY id DESC LIMIT 100`).all()).results || [];
        return json({ ok: true, config: { feeRate, minWithdraw, platformWallet }, users, tasks, reviews });
      }

      // 3. Publish Task / Bounty
      if (path === "/api/gig/tasks" && request.method === "POST") {
        const body = await request.json();
        const { employer_id, employer_name, mode, category, title, reward_usdt, deadline, location, description, escrow_tx } = body;
        if (!employer_id || !title || !reward_usdt || reward_usdt <= 0) {
          return json({ ok: false, error: "Invalid task parameters" }, 400);
        }
        await ensureUser(employer_id, "", employer_name || employer_id);
        const id = "T-" + Math.floor(10000 + Math.random() * 90000);
        const escrowed = mode === "BOUNTY" && escrow_tx ? 1 : 0;

        await env.DB.prepare(
          `INSERT INTO gig_tasks (id, mode, category, title, reward_usdt, fee_rate, escrowed, escrow_tx, deadline, location, description, employer_id)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
        ).bind(id, mode || "BOUNTY", category || "软件开发", title, reward_usdt, feeRate, escrowed, escrow_tx || "", deadline || "72h", location || "Remote", description || "", employer_id).run();

        if (escrowed) {
          await env.DB.prepare(`UPDATE gig_users SET frozen_usdt = frozen_usdt + ? WHERE tg_id = ?`).bind(reward_usdt, employer_id).run();
          await notifyAdmin(`🏆 <b>新悬赏任务托管</b>\n任务：${title}\n赏金：<b>${reward_usdt} USDT</b>（抽佣 ${Math.round(feeRate * 100)}%）\n雇主：${employer_name} (${employer_id})\nTON TX: <code>${escrow_tx}</code>`);
        }
        return json({ ok: true, id });
      }

      // 4. Accept Task
      if (path.match(/^\/api\/gig\/tasks\/[^/]+\/accept$/) && request.method === "POST") {
        const taskId = path.split("/")[4];
        const { worker_id, worker_name } = await request.json();
        await ensureUser(worker_id, "", worker_name || worker_id);
        const task = await env.DB.prepare(`SELECT * FROM gig_tasks WHERE id = ?`).bind(taskId).first();
        if (!task || task.status !== "OPEN") return json({ ok: false, error: "Task unavailable" }, 400);
        if (task.employer_id === worker_id) return json({ ok: false, error: "Cannot accept own task" }, 400);

        await env.DB.prepare(`UPDATE gig_tasks SET worker_id = ?, status = 'IN_PROGRESS' WHERE id = ?`).bind(worker_id, taskId).run();
        return json({ ok: true });
      }

      // 5. Submit Work
      if (path.match(/^\/api\/gig\/tasks\/[^/]+\/submit$/) && request.method === "POST") {
        const taskId = path.split("/")[4];
        const { worker_id, delivery_note } = await request.json();
        const task = await env.DB.prepare(`SELECT * FROM gig_tasks WHERE id = ?`).bind(taskId).first();
        if (!task || task.worker_id !== worker_id) return json({ ok: false, error: "Unauthorized" }, 403);

        await env.DB.prepare(`UPDATE gig_tasks SET delivery_note = ?, status = 'SUBMITTED' WHERE id = ?`).bind(delivery_note || "", taskId).run();
        return json({ ok: true });
      }

      // 6. Approve & Pay (Auto-deduct 10% Platform Commission)
      if (path.match(/^\/api\/gig\/tasks\/[^/]+\/approve$/) && request.method === "POST") {
        const taskId = path.split("/")[4];
        const { employer_id } = await request.json();
        const task = await env.DB.prepare(`SELECT * FROM gig_tasks WHERE id = ?`).bind(taskId).first();
        if (!task || task.employer_id !== employer_id || task.status !== "SUBMITTED") {
          return json({ ok: false, error: "Cannot approve task" }, 400);
        }
        const rate = task.fee_rate ?? feeRate;
        const platformFee = Number((task.reward_usdt * rate).toFixed(2));
        const workerNet = Number((task.reward_usdt - platformFee).toFixed(2));

        await env.DB.batch([
          env.DB.prepare(`UPDATE gig_tasks SET status = 'COMPLETED' WHERE id = ?`).bind(taskId),
          env.DB.prepare(`UPDATE gig_users SET frozen_usdt = MAX(0, frozen_usdt - ?) WHERE tg_id = ?`).bind(task.reward_usdt, employer_id),
          env.DB.prepare(`UPDATE gig_users SET balance_usdt = balance_usdt + ? WHERE tg_id = ?`).bind(workerNet, task.worker_id)
        ]);

        await notifyAdmin(`✅ <b>任务验收放款完成</b>\n单号：${taskId}\n总赏金：${task.reward_usdt} USDT\n接单人实得：<b>${workerNet} USDT</b>\n平台抽佣(${Math.round(rate * 100)}%)：<b>${platformFee} USDT</b>`);
        return json({ ok: true, workerNet, platformFee });
      }

      // 7. Bidirectional Review
      if (path.match(/^\/api\/gig\/tasks\/[^/]+\/review$/) && request.method === "POST") {
        const taskId = path.split("/")[4];
        const { kind, reviewer_id, reviewer_name, stars, tags, comment } = await request.json();
        const task = await env.DB.prepare(`SELECT * FROM gig_tasks WHERE id = ?`).bind(taskId).first();
        if (!task || task.status !== "COMPLETED") return json({ ok: false, error: "Task not completed" }, 400);

        const targetId = kind === "task" ? task.worker_id : task.employer_id;
        await env.DB.prepare(
          `INSERT INTO gig_reviews (task_id, kind, reviewer_id, reviewer_name, target_id, stars, tags, comment)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
        ).bind(taskId, kind, reviewer_id, reviewer_name, targetId, stars, tags || "", comment || "").run();

        const target = await env.DB.prepare(`SELECT * FROM gig_users WHERE tg_id = ?`).bind(targetId).first();
        if (target) {
          if (kind === "task") {
            const newCount = target.worker_count + 1;
            const newScore = (target.worker_score * target.worker_count + stars) / newCount;
            await env.DB.prepare(`UPDATE gig_users SET worker_score = ?, worker_count = ? WHERE tg_id = ?`).bind(newScore, newCount, targetId).run();
          } else {
            const newCount = target.employer_count + 1;
            const newScore = (target.employer_score * target.employer_count + stars) / newCount;
            await env.DB.prepare(`UPDATE gig_users SET employer_score = ?, employer_count = ? WHERE tg_id = ?`).bind(newScore, newCount, targetId).run();
          }
        }
        return json({ ok: true });
      }

      // 8. Worker Withdrawal Request (Min 10 USDT -> Telegram Admin Notification)
      if (path === "/api/gig/withdraw" && request.method === "POST") {
        const { tg_id, username, amount_usdt, ton_wallet } = await request.json();
        const amt = parseFloat(amount_usdt || "0");
        if (!tg_id || !ton_wallet || amt < minWithdraw) {
          return json({ ok: false, error: `最低提现金额为 ${minWithdraw} USDT，且需填写有效 TON 钱包地址` }, 400);
        }
        const user = await env.DB.prepare(`SELECT * FROM gig_users WHERE tg_id = ?`).bind(tg_id).first();
        if (!user || user.balance_usdt < amt) {
          return json({ ok: false, error: "可提现余额不足" }, 400);
        }

        await env.DB.batch([
          env.DB.prepare(`UPDATE gig_users SET balance_usdt = balance_usdt - ?, ton_wallet = ? WHERE tg_id = ?`).bind(amt, ton_wallet, tg_id),
          env.DB.prepare(`INSERT INTO gig_withdrawals (tg_id, username, amount_usdt, ton_wallet) VALUES (?, ?, ?, ?)`).bind(tg_id, username || "", amt, ton_wallet)
        ]);

        await notifyAdmin(`💸 <b>新提现申请（待人工审核放款）</b>\n用户：${user.display_name} (@${username || tg_id})\n提现金额：<b>${amt} USDT</b>\n收款 TON 钱包：\n<code>${ton_wallet}</code>`);
        return json({ ok: true, message: "提现申请已提交，将通过 @Userstudiobot 审核并打款至您的 TON 钱包" });
      }

      // 9. Dispute Arbitration Ticket
      if (path === "/api/gig/dispute" && request.method === "POST") {
        const { task_id, requester_id, requester_name, reason } = await request.json();
        await env.DB.prepare(`UPDATE gig_tasks SET status = 'DISPUTED' WHERE id = ?`).bind(task_id).run();
        await notifyAdmin(`⚖️ <b>零工任务纠纷仲裁申请</b>\n单号：${task_id}\n申请人：${requester_name} (${requester_id})\n原因：${reason || "交付存在争议"}`);
        return json({ ok: true });
      }

      return json({ ok: false, error: "Not Found" }, 404);
    } catch (err) {
      return json({ ok: false, error: String(err.message || err) }, 500);
    }
  }
};

